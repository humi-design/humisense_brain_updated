# Backend API base path (proxied in dev by vite.config.ts)
VITE_API_BASE=/api/v1
# Dev proxy target
VITE_API_TARGET=http://localhost:8000

# --- OIDC / OpenID Connect ------------------------------------------------
# The frontend authenticates against an OIDC provider and sends the resulting
# access token as a bearer token.  It never sends tenant or role headers: the
# backend resolves identity from the verified token alone.
#
# All of these are baked in at build time and are therefore PUBLIC.  Do not
# put client secrets here -- a browser application is a public OAuth client
# and must use Authorization Code flow with PKCE, which needs no secret.
#
# If VITE_OIDC_AUTHORITY or VITE_OIDC_CLIENT_ID is unset the app renders an
# "authentication not configured" screen instead of failing silently.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Optional. Defaults to <origin>/auth/callback and <origin>/auth/logged-out.
# Must match a redirect URI registered on the provider exactly.
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
# Optional. Defaults to "openid profile email".
VITE_OIDC_SCOPE=
