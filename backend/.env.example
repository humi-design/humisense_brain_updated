# Copy to .env and fill in. Never commit the filled-in file.

HUMISENSE_ENVIRONMENT=development
HUMISENSE_DEBUG=false
HUMISENSE_DATABASE_URL=sqlite+pysqlite:///./humisense_dev.db

# Required in production. Generate with:
#   python -c "from app.core.crypto import generate_master_key; print(generate_master_key())"
HUMISENSE_CREDENTIAL_ENCRYPTION_KEY=

# Egress / SSRF. Leave the private-range denial on.
HUMISENSE_EGRESS_ALLOW_PRIVATE=false
HUMISENSE_EGRESS_ALLOWED_HOSTS=
HUMISENSE_EGRESS_BLOCKED_HOSTS=

HUMISENSE_CORS_ORIGINS=http://localhost:5173
